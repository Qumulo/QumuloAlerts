# Rebuild the associative table so the new rows are linked to their language records

insert ignore into assoc_langtranslations(lang_id, translations_id)
    select l.id as lang_id, t.id as translations_id
    from languages l
    inner join lang_translations t
    where l.locale = t.locale
      and t.lookup_name in ('audit-connected', 'audit-connect-error');
